{
  "name": "davo-expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Davo Solutions internal expenses and profit tracker",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/domain/*.test.ts tests/security/*.test.ts",
    "test:e2e": "playwright test",
    "env:check": "tsx scripts/check-env.ts",
    "cloudinary:check": "node scripts/check-cloudinary.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "lucide-react": "1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
