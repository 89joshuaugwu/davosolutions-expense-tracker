# This app MUST use its own Firebase project. Never copy Ads Manager credentials.
# Copy this file to .env.local and replace placeholders. No credentials are needed for /preview.
APP_URL=http://localhost:3000

# Optional: LAN origin for mobile testing on the same Wi-Fi network. Leave blank in production.
LAN_URL=
# Firebase web application config (public identifiers, never private keys).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Use escaped newlines (\n) in FIREBASE_PRIVATE_KEY.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary selected for private images, PDFs and documents; workflows pending.
# Credentials stay SERVER ONLY. Signed uploads must force authenticated delivery.
ATTACHMENT_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Unused: retained only if imported from Firebase web config. No Firebase Storage needed.
FIREBASE_STORAGE_BUCKET=

# Bill reminder SMTP — reserved for the reminder phase; not wired yet.
# Port 465: SMTP_SECURE=true. Port 587: false (require STARTTLS in code).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Scheduled reminders — server-only bearer secret; not wired yet.
CRON_SECRET=
