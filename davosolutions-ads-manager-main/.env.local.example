# ─────────────────────────────────────────────────────────
# Firebase Client SDK — from Project settings → General → Your apps
# Safe to expose to the browser (that's what NEXT_PUBLIC_ means here)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────
# Firebase Admin SDK — Project settings → Service accounts → Generate new private key
# SERVER-ONLY. Never prefix these with NEXT_PUBLIC_, never commit the JSON key.
# Paste the "private_key" value exactly, keep the \n escapes as-is —
# the app converts them back to real newlines at runtime.
# ─────────────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────
# Password vault — SERVER-ONLY secret used to AES-256 encrypt/decrypt
# Gmail passwords. Generate a long random string, e.g.:
#   openssl rand -base64 48
# Changing this after you've saved passwords makes old ones undecryptable.
# ─────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────
# Cloudinary — cloud name from your dashboard, upload preset must be
# created as "Unsigned" (Settings → Upload → Upload presets → Add preset)
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

SUPER_ADMIN_EMAIL=admin@adsanalytics.davosolutions.com
SUPER_ADMIN_EMAIL2=admin@.davosolutions.com
SMTP_HOST=server214.web-hosting.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@davosolutions.com
SMTP_PASS=IamDavoSolutions.com(noreplyemail)
SMTP_FROM="Davo Ads Manager <noreply@example.com>"
